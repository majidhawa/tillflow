# Copy to terraform.tfvars and adjust as needed.
# terraform.tfvars is expected to be gitignored — do not commit real values.

region      = "eu-west-3"
name_prefix = "devops-g8"

vpc_cidr             = "10.20.0.0/16"
azs                  = ["eu-west-3a", "eu-west-3b"]
public_subnet_cidrs  = ["10.20.0.0/24", "10.20.1.0/24"]
private_subnet_cidrs = ["10.20.10.0/24", "10.20.11.0/24"]

single_nat_gateway = true

# --- ECS golden path ---
# Leave enable_services = false (and image_tags as "pending") until real
# images have been pushed to ECR under real immutable tags.
app_names      = ["web", "pos", "payments", "commission"]
container_port = 8080

image_tags = {
  web        = "pending"
  pos        = "pending"
  payments   = "pending"
  commission = "pending"
}

enable_services = false

# --- RDS PostgreSQL ---
# Verify rds_engine_version against currently available RDS versions in
# eu-west-3 before apply. Credentials are generated by Terraform and
# stored only in Secrets Manager — never set a password here.
rds_engine_version    = "16.14"
rds_instance_class    = "db.t4g.micro"
rds_allocated_storage = 20
rds_db_name           = "tillflow"

# --- Redis / Valkey ---
redis_engine         = "valkey"
redis_engine_version = "7.2"
redis_node_type      = "cache.t4g.micro"

# --- SQS ---
sqs_queue_name = "payment-events"

# --- S3 ---
# artifacts/backups/evidence are the capstone brief's required platform
# buckets (state and ALB access logs are provisioned separately).
s3_purposes        = ["receipts", "reports", "audit", "artifacts", "backups", "evidence"]
s3_expiration_days = { artifacts = 90 }

# --- EventBridge ---
# No target is wired yet — see infra/modules/eventbridge-schedule/main.tf.
commission_schedule_expression = "cron(0 2 * * ? *)"

# --- Secrets placeholders ---
# No values are set here or anywhere in Terraform — these are empty
# Secrets Manager containers only. Populate real values out-of-band
# (console/CLI) after apply, never commit them.
app_secret_placeholders = [
  {
    key         = "daraja"
    description = "M-Pesa Daraja API credentials/config. Value must be set out-of-band, never committed."
  },
  {
    key         = "slack-webhook"
    description = "Slack webhook URL for operational notifications. Value must be set out-of-band, never committed."
  },
]

tags = {
  owner       = "hawa"
  service     = "platform"
  group       = "8"
  environment = "capstone"
  managed-by  = "terraform"
  capstone    = "tillflow"
}
